{
  "name": "site-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"pnpm --filter @sb/web dev\" \"pnpm --filter @sb/worker dev\"",
    "start:web": "pnpm --filter @sb/web start",
    "start:worker": "pnpm --filter @sb/worker start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.islands.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx --env-file-if-exists=.env tools/eval/src/cli.ts",
    "check:firefox": "tsx tools/eval/src/firefox-export.ts",
    "fonts": "tsx packages/render/scripts/build-fonts.ts",
    "fixtures:photos": "tsx tools/eval/src/fixtures/generate-photos.ts",
    "fixtures:ai-photos": "tsx tools/eval/src/fixtures/ai-photos.ts",
    "examples:build": "tsx tools/eval/src/examples/build.ts",
    "dev:lite": "pnpm --filter @sb/web dev",
    "seed": "tsx --env-file-if-exists=.env tools/eval/src/seed.ts",
    "templates:compare": "tsx tools/eval/src/templates-compare.ts",
    "study": "tsx tools/eval/src/study.ts",
    "zero-to-live": "tsx tools/eval/src/zero-to-live.ts",
    "eval:junk": "tsx --env-file-if-exists=.env tools/eval/src/junk-cli.ts",
    "smoke:launch": "tsx --env-file-if-exists=.env tools/eval/src/smoke-launch.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
