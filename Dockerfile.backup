# Backup service: Railway cron job (nightly 03:00 UTC) that runs `db:backup` inside Railway, so the database URL
# never leaves it, then exits. The same image runs the restore drill by hand (start command below).
# Same base and layout as Dockerfile.web (node:24-slim, unprivileged `node` user), kept minimal: only
# @sb/platform and what it imports (config, spec), tsx, the config files, and the PostgreSQL 18 client from the
# PGDG apt repository (pg_dump/psql must be at least the server's major version; production runs PostgreSQL 18).
#
# Start commands (working directory /app/apps/worker):
#   backup (the cron's default): node --import tsx ../../packages/platform/scripts/backup.ts
#   restore drill (one-off):     node --import tsx ../../packages/platform/scripts/restore-drill.ts

FROM node:24-slim AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/components/package.json packages/components/
COPY packages/config/package.json packages/config/
COPY packages/engine/package.json packages/engine/
COPY packages/inventory/package.json packages/inventory/
COPY packages/platform/package.json packages/platform/
COPY packages/render/package.json packages/render/
COPY packages/spec/package.json packages/spec/
COPY tools/eval/package.json tools/eval/
# @sb/platform and its workspace dependencies, plus the worker's direct dependencies only (that is tsx at the
# lockfile's version; the engine's own dependencies are not installed): about 55 packages.
RUN pnpm install --frozen-lockfile --prod --filter "@sb/platform..." --filter "@sb/worker"

FROM node:24-slim
# PostgreSQL 18 client only (no server), from PGDG; curl and gnupg are not kept, apt lists removed.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && install -d /usr/share/postgresql-common/pgdg \
  && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
  && . /etc/os-release \
  && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-18 \
  && apt-get purge -y --auto-remove curl \
  && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/lib/postgresql/18/bin:$PATH
ENV NODE_ENV=production
WORKDIR /app
# node_modules from the deps stage; only the source the scripts load, owned by root, read-only to the app.
COPY --from=deps /app /app
COPY config config
COPY packages/config packages/config
COPY packages/spec packages/spec
COPY packages/platform packages/platform
USER node
WORKDIR /app/apps/worker
CMD ["node", "--import", "tsx", "../../packages/platform/scripts/backup.ts"]
