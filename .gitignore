node_modules/
dist/
# The morph engine's drop-in build is committed for other projects to copy (a test keeps it fresh).
!packages/morph/dist/
.tools/
.worktrees/
.claude/worktrees/
.claude/agent-log.jsonl
.env
.env.*
!.env.example
.data/
coverage/
*.log
.turbo/
eval/runs/*
# Template comparisons (pnpm templates:compare): the side-by-side pictures and checks are kept for review.
!eval/runs/templates-*/
eval/runs/templates-*/site/
eval/runs/templates-*/*.png
# Free re-renders of the Review 50 pages (pnpm review50:render): screenshots, regenerated at will.
eval/runs-review50-*/
test-results/
playwright-report/
.claude/launch.json

# Review sheets (tools/eval/src/look.ts) are regenerated by every eval; large PNGs.
eval/look/

# Okus round pictures: published as the Okus artifact's files, not kept in git (regenerate with pnpm okus:items).
tools/okus/rounds/*/img/

# Approval round pictures and sites: published as the approval artifact files, not kept in git (regenerate with pnpm approval:build).
tools/approval/round/img/
tools/approval/round/site/
.claude/plans/

# Stranko HQ data (tools/hq): local, rewritten by Claude each run; seed from tools/hq/data.example.js.
.hq/
