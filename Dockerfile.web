# Web service: dashboard, API, preview and published sites at /s/{slug}/.
FROM node:24-slim
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
EXPOSE 3000
# Node directly (not pnpm → pnpm → tsx → node): ~80 MB less, and SIGTERM reaches the app for a clean shutdown.
WORKDIR /app/apps/web
CMD ["node", "--import", "tsx", "src/main.ts"]
