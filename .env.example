# Copy to .env. Every variable the app reads is listed here. Never commit .env.

# Anthropic API key. Only the pipeline, AI chat edits and `pnpm eval` use it; unit tests never do.
# On Railway: on the worker, and on the web service too (the intake's junk check asks the classifier there
# before queueing; without it the check falls back to the worker's pipeline).
ANTHROPIC_API_KEY=

# The admin's (product owner's) password (>= 12 chars): sees every site and manages the allow-list at /admin.
# Business owners sign in by email link instead. On Railway: variable ACCESS_PASSWORD, generated.
ACCESS_PASSWORD=change-me-local-only
# Signing key for cookies and CSRF tokens, and the key of the IP hashes; derived from ACCESS_PASSWORD when empty.
# Set it on Railway (web service) so changing the password doesn't sign everyone out.
SESSION_SECRET=

# Sign-in emails (magic links) via Resend. Without a key in development the link is printed to the web
# server's console; deployed (NODE_ENV=production) without a key, email sign-in is refused with a message.
# On Railway: RESEND_API_KEY and EMAIL_FROM on the web service. EMAIL_FROM must be on the domain verified
# in Resend, e.g. Stranko <prijava@stranko.einvoicecheck.eu> (DNS records: TASKS.md, "Transactional email").
RESEND_API_KEY=
EMAIL_FROM=
# Cloudflare Turnstile (bot check on the intake for visitors without an account; sb-bot-check). Without keys in
# development the check is skipped with a log line; deployed (NODE_ENV=production) without keys, previews without
# an account are refused (signed-in owners can still generate). On Railway: both on the web service. Cloudflare's
# published test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA;
# with them the deployed smoke test (remote-smoke.ts --limits) can run its anonymous steps.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Public address used in sign-in links. Optional on Railway (RAILWAY_PUBLIC_DOMAIN is used); set it for a
# custom domain. Locally the request's own address is used.
APP_URL=

# Postgres (docker compose). Docker-less alternative: pglite://./.data/pg (web then runs jobs in-process).
# If 5432 is taken by a local Postgres, set POSTGRES_PORT=5433 (docker compose reads it) and use it in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgres://sitebuilder:sitebuilder@localhost:5432/sitebuilder

# Storage: "s3" (MinIO locally, Railway bucket when deployed) or "fs" (STORAGE_DIR).
# Locally: the S3_* variables below (MinIO). On Railway: reference the bucket's own variables
# BUCKET, ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION (used when S3_* are unset).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sitebuilder
S3_ACCESS_KEY_ID=sitebuilder
S3_SECRET_ACCESS_KEY=sitebuilder-secret
# Path-style URLs: default true when S3_ENDPOINT is set (MinIO), false for Railway buckets.
S3_FORCE_PATH_STYLE=true
STORAGE_DIR=.data/storage

# Web port.
PORT=3000
# Run job handlers inside the web process (automatic with pglite).
RUN_WORKER_INLINE=false
# Railway's draining window in seconds (SIGTERM → SIGKILL on a redeploy; Railway's default is 0). Railway reads it
# as a service variable; the worker reads it too and lets running jobs finish for this long minus config
# worker.drainReserveSeconds, then marks the rest interrupted. Unset locally (config worker.drainSeconds applies).
# On Railway: on the worker, long enough for a generation (e.g. 300).
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=

# Daily model-spend cap in EUR; overrides config/app.config.json limits.dailyModelSpendCapEur. The per-tier pools
# (config tiers.pools) are shares of it.
DAILY_SPEND_CAP_EUR=
# Alternative config file path (tests, experiments).
APP_CONFIG_PATH=
# Replay recorded model responses from this directory instead of calling the API (offline demos).
MODEL_REPLAY_DIR=

# fal.ai key. The worker uses it to generate up to config imageGen.pipeline.fillUpTo (per scope) labelled mood images
# for sites whose owner gave too few photos (without it, no images are generated); `pnpm fixtures:ai-photos`
# and `pnpm eval` use it too. On Railway: variable FAL_KEY on the worker (and web, which runs jobs with
# PGlite). For Claude Code's fal MCP server (.mcp.json) set it as a Windows user environment variable;
# tools/mcp/fal-headers.ps1 reads it from there. See docs/research/image-generation.html.
FAL_KEY=
# Set to "production" when deployed (secure cookies, minified editor bundle).
NODE_ENV=development

# Tools and tests only (not read by the app; set them on the command line when needed).
# Deployed base URL that tools/eval/src/remote-smoke.ts and remote-intake.ts run against.
# REMOTE_URL=
# That deployment's admin password (its ACCESS_PASSWORD), used by the same remote-*.ts scripts to sign in.
# REMOTE_PASSWORD=
# Browser tests (apps/web/test/*-browser.test.ts): directory to save screenshots into.
# SB_SHOTS=
# owner-tasks browser test: file to write the per-task tap counts to as JSON.
# SB_TAPS_OUT=
